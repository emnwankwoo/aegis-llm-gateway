# ---------------------------------------------------------------
# AegisGate configuration. Copy to .env and fill in real values.
# NEVER commit .env — it is listed in .gitignore.
# Generate strong keys with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ---------------------------------------------------------------

# Comma-separated keys for apps that call POST /v1/chat
AEGIS_CLIENT_API_KEYS=change-me-client-key-1,change-me-client-key-2

# Comma-separated keys for the security dashboard (audit endpoints only)
AEGIS_ADMIN_API_KEYS=change-me-admin-key

# "mock" runs fully offline (great for demos & tests). "openai" calls the real API.
AEGIS_LLM_PROVIDER=mock
AEGIS_OPENAI_API_KEY=
AEGIS_OPENAI_MODEL=gpt-4o-mini
AEGIS_OPENAI_BASE_URL=https://api.openai.com/v1
AEGIS_ENABLE_MODERATION=false

# Denial-of-Wallet controls
AEGIS_RATE_LIMIT_REQUESTS=20
AEGIS_RATE_LIMIT_WINDOW_SECONDS=60
AEGIS_MAX_OUTPUT_TOKENS=512
AEGIS_UPSTREAM_TIMEOUT_SECONDS=30

# Guardrail tuning: block when combined injection risk >= this (0.0 - 1.0)
AEGIS_INJECTION_BLOCK_THRESHOLD=0.7

# Output guard: URLs to any other domain get stripped from responses
AEGIS_ALLOWED_URL_DOMAINS=docs.python.org,owasp.org,paloaltonetworks.com,github.com

# Audit trail
AEGIS_AUDIT_LOG_PATH=logs/audit.jsonl
AEGIS_AUDIT_BUFFER_SIZE=500

# Set false in production to hide /docs and /openapi.json
AEGIS_EXPOSE_DOCS=true
